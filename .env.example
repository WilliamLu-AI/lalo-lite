OMNI_API_KEY=
OMNI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-flash
MINIMAX_API_KEY=
MINIMAX_MODEL=speech-2.6-hd
MINIMAX_VOICE_ID=male-qn-qingse
MINIMAX_WS_URL=wss://api.minimaxi.com/ws/v1/t2a_v2
CODEX_BINARY=
CODEX_PROXY=
# Claude executable path, or a JSON array when fixed arguments are required.
CLAUDE_COMMAND=

# Optional independent chapter locator
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0

# model: existing combined navigation; jev: independent chapter selection
FOLLOW_LOCATOR=model

# Voice execution backend, fixed when a new explanation connection is created.
# native: Lalo pipeline; livekit: real AgentSession with existing browser/WS IO.
VOICE_RUNTIME=native

# Default profile initialization only; saved UI profiles take precedence thereafter.
# Streaming ASR uses OMNI_API_KEY unless explicitly overridden.
# HTTP base URLs never determine custom WS endpoints. Fill the full URL below.
STREAMING_ASR=on
STREAMING_ASR_API_KEY=
STREAMING_ASR_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
STREAMING_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
STREAMING_ASR_LANGUAGES=zh,en
